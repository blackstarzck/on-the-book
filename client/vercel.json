{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": { "deploymentEnabled": { "main": false } },
  "installCommand": "cd .. && npm ci",
  "buildCommand": "cd .. && npm run build:client",
  "outputDirectory": "../dist/client",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/index?route=/uploads/:path*" },
    { "source": "/", "destination": "/client/index.html" },
    { "source": "/client/", "destination": "/client/index.html" }
  ]
}
