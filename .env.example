# On the Book 환경변수. 이 파일을 .env 로 복사해 값을 채웁니다(.env 는 커밋하지 않음).
# npm run dev / npm start 가 .env 를 읽습니다. Vercel 두 프로젝트에도 같은 값을 등록합니다.

# Supabase 프로젝트(on-the-project) 주소와 service_role 키.
# 대시보드 > Project Settings > API. service_role 키는 서버 전용이며 화면 코드로 보내지 않습니다.
SUPABASE_URL=https://razpvjtsmaoizjbtpxqs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 비밀번호. 로컬에서는 비우면 로그인 없이 관리 화면을 씁니다. Vercel 관리자 프로젝트는 필수입니다.
ADMIN_PASSWORD=
